# --- 2. THE DEAL KNOWLEDGE DIRECTORY (ANONYMIZED) ---
# This dictionary simulates the high-confidence patterns using generic names.

DEAL_KNOWLEDGE_BASE = {
    "DEAL ALPHA 2022": {
        "Deal ID": "D1000007", "Product ID": "PID00006", "LoanId": "D1000007-4"
    },
    "PROJECT ZETA": {
